# ResearchLens AI - Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
# Leave empty to automatically use embedded in-memory MongoDB during local testing
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster1.12rnegi.mongodb.net/?appName=Cluster1"

# Authentication
JWT_SECRET=researchlens-ai-secure-jwt-secret-replace-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d

# Google Gemini AI API
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_research_api_key_here"
GEMINI_MODEL=gemini-1.5-flash

# Document Upload Limits
MAX_FILE_SIZE_MB=15
