# ResearchLens AI — Global Environment Variables Example

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
# Optional for local development; embedded in-memory database will run if left empty
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster1.12rnegi.mongodb.net/?appName=Cluster1"

# Authentication
JWT_SECRET=your_jwt_secret_32_characters_minimum_for_security
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your API key at: "your_gemini_research_api_key_here"
GEMINI_API_KEY="your_gemini_research_api_key_here"
GEMINI_MODEL=gemini-1.5-flash

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:5000"

